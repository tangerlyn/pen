rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // authorId 필드가 아예 없는 레거시 문서(작성자 필수화 규칙 이전에 생성된
    // 리뷰/게시글/댓글/답글)에서 resource.data.authorId를 직접 읽으면 필드
    // 부재로 규칙 평가 자체가 에러 나 permission-denied로 보인다.
    // get(..., null)로 안전하게 기본값을 둬 "소유자 불명 → 거부"로 정상
    // 평가되게 한다.
    function isOwnedResource(data) {
      return isOwner(data.get('authorId', null));
    }

    function isFollowing(followerId, followeeId) {
      return exists(/databases/$(database)/documents/follows/$(followerId + '_' + followeeId));
    }

    function canReadInkBook(uid, bookData) {
      return isOwner(uid)
        || (isLoggedIn() && (bookData.visibility == 'public' || bookData.isPublic == true))
        || (isLoggedIn() && bookData.visibility == 'followers'
            && isFollowing(request.auth.uid, uid));
    }

    // get()을 함수 인자로 전달하면 파서 오류 → 별도 함수로 분리
    function canReadInkChart(uid, bookId) {
      return isLoggedIn() && (
        get(/databases/$(database)/documents/users/$(uid)/inkBooks/$(bookId)).data.visibility == 'public'
        || get(/databases/$(database)/documents/users/$(uid)/inkBooks/$(bookId)).data.isPublic == true
        || (get(/databases/$(database)/documents/users/$(uid)/inkBooks/$(bookId)).data.visibility == 'followers'
            && isFollowing(request.auth.uid, uid))
      );
    }

    // create 시 요청 데이터의 소유자 필드가 본인 uid와 일치하는지 확인 (작성자 스푸핑 방지)
    function isOwnedCreate(field) {
      return isLoggedIn() && request.resource.data[field] == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isLoggedIn();
      allow write: if isOwner(uid);
      // exp: 다른 사람이 내 리뷰/게시글에 좋아요 눌렀을 때 작성자에게 EXP를
      // 지급하는 트랜잭션이 본인이 아닌 유저의 문서를 건드려야 해서 필요
      allow update: if isOwner(uid)
        || (isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['followerCount', 'followingCount', 'exp']));

      match /following/{targetUid} {
        allow read: if isLoggedIn();
        allow write: if isOwner(uid);
      }
      match /followers/{fromUid} {
        allow read: if isLoggedIn();
        // 팔로우 시 상대방의 followers에 내 항목을 써야 하므로 isOwner(uid)로는 못 막지만,
        // 최소한 "내 항목(fromUid)"만 건드리도록 제한 — 남의 팔로워 목록 조작 방지
        allow write: if isLoggedIn() && request.auth.uid == fromUid;
      }
      match /inkCollection/{inkId} {
        allow read: if isLoggedIn();
        allow write: if isOwner(uid);
      }
      match /inkChart/{chartId} {
        allow read: if isLoggedIn();
        allow write: if isOwner(uid);
      }
      match /inkBooks/{bookId} {
        allow read: if canReadInkBook(uid, resource.data);
        allow write: if isOwner(uid);

        match /inkChart/{chartId} {
          allow read: if isOwner(uid) || canReadInkChart(uid, bookId);
          allow write: if isOwner(uid);
        }
      }
      match /wishlist/{itemId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /follows/{docId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
          && request.auth.uid == request.resource.data.followerId;
      allow delete: if isLoggedIn()
          && request.auth.uid == resource.data.followerId;
    }

    match /inks/{inkId} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn();
      allow delete: if false;
    }

    match /pens/{penId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if false;
    }

    match /inquiries/{inquiryId} {
      allow create: if isOwnedCreate('uid');
      allow read: if isLoggedIn() && request.auth.uid == resource.data.uid;
      allow update: if false;
    }

    match /papers/{paperId} {
      allow read: if isLoggedIn();
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isLoggedIn();
      allow create: if isOwnedCreate('authorId');
      allow update: if isOwnedResource(resource.data)
        || (isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likeCount', 'scrapCount', 'commentCount']));
      allow delete: if isOwnedResource(resource.data);

      match /likes/{likeId} {
        // likes 문서 ID가 곧 uid — 본인 좋아요 문서만 읽고 쓸 수 있음
        allow read: if isLoggedIn();
        allow write: if isOwner(likeId);
      }
      match /scraps/{scrapId} {
        // scraps 문서 ID가 곧 uid — 본인 스크랩 문서만 읽고 쓸 수 있음
        allow read: if isLoggedIn();
        allow write: if isOwner(scrapId);
      }
      match /comments/{commentId} {
        allow read: if isLoggedIn();
        allow create: if isOwnedCreate('authorId');
        allow update: if isOwnedResource(resource.data);
        allow delete: if isOwnedResource(resource.data);

        match /replies/{replyId} {
          allow read: if isLoggedIn();
          allow create: if isOwnedCreate('authorId');
          allow update: if isOwnedResource(resource.data);
          allow delete: if isOwnedResource(resource.data);
        }
      }
    }

    match /posts/{postId} {
      allow read: if isLoggedIn();
      allow create: if isOwnedCreate('authorId');
      allow update: if isOwnedResource(resource.data)
        || (isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likeCount', 'commentCount']));
      allow delete: if isOwnedResource(resource.data);

      match /likes/{likeId} {
        // likes 문서 ID가 곧 uid — 본인 좋아요 문서만 읽고 쓸 수 있음
        allow read: if isLoggedIn();
        allow write: if isOwner(likeId);
      }
      match /scraps/{scrapId} {
        // scraps 문서 ID가 곧 uid — 본인 스크랩 문서만 읽고 쓸 수 있음
        allow read: if isLoggedIn();
        allow write: if isOwner(scrapId);
      }
      match /comments/{commentId} {
        allow read: if isLoggedIn();
        allow create: if isOwnedCreate('authorId');
        allow update: if isOwnedResource(resource.data);
        allow delete: if isOwnedResource(resource.data);

        match /replies/{replyId} {
          allow read: if isLoggedIn();
          allow create: if isOwnedCreate('authorId');
          allow update: if isOwnedResource(resource.data);
          allow delete: if isOwnedResource(resource.data);
        }
      }
    }

    match /reports/{reportId} {
      allow create: if isOwnedCreate('reporterId');
      // 다른 사람의 신고 내용은 여전히 볼 수 없지만, 본인이 이미 신고했는지
      // 확인하는 hasReported() 조회(문서 ID로 직접 get)는 허용한다. 문서가
      // 없으면(아직 신고 안 함) resource가 null이라 앞의 조건에서 안전하게
      // 걸러진다.
      allow read: if isLoggedIn() && resource != null
          && resource.data.reporterId == request.auth.uid;
    }

    match /productRequests/{requestId} {
      allow create: if isOwnedCreate('requesterId');
      allow read: if isLoggedIn() && request.auth.uid == resource.data.requesterId;
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, write: if request.auth.uid == uid;
    }
  }
}
